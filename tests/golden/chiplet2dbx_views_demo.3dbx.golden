# Derived from views_demo.chiplet by chiplet2dbx (ADK); regenerate, do not edit.
Header:
  version: 3
  unit: micron
  precision: 1000
  include:
    - views_demo.3dbv

Design:
  name: "views_demo"
  external:
    verilog_file: ../top.v

ChipletInst:
  interposer:
    reference: SUBSTRATE
  U1:
    reference: DIE_F
  U2:
    reference: DIE_U

Stack:
  interposer:
    loc: [0, 0]
    z: 0
    orient: R0
  U1:
    loc: [50, 110]
    z: 35
    orient: MZ_MY
  U2:
    loc: [250, 110]
    z: 35
    orient: R0

Connection:
  U1_attach:
    top: U1.regions.front
    bot: interposer.regions.front
    thickness: 25
  U2_attach:
    top: U2.regions.back
    bot: interposer.regions.front
    thickness: 25
  interposer_mount:
    top: interposer.regions.back
    bot: ~
    thickness: 0
